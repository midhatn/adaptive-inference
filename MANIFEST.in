include README.md PLAN.md CONTRIBUTING.md SECURITY.md CITATION.cff REFERENCES.bib requirements.lock CHANGELOG.md AGENTS.md
include .gitattributes .gitignore
recursive-include .github *.yml *.yaml *.md
recursive-include docs *.md
recursive-include examples *.json *.json5 *.yaml *.yml *.py *.md
recursive-include integrations *.py *.md *.json *.yaml *.patch *.txt *.bundle *.gz LICENSE NOTICE
recursive-include provenance *.json *.py
recursive-include upstream *.json
recursive-include tests *.py
recursive-include third_party LICENSE NOTICE .gitattributes *.txt *.md *.json *.py *.mjs *.scala *.rs
global-exclude __pycache__ *.py[cod] *.log
