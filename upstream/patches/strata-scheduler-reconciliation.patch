index 0000000000000000000000000000000000000000..60150cf569d53aaaa6933e2eac4ba125f39b5966
--- /dev/null
+++ b/serve/test_inference_queue.py
@@ -0,0 +1,231 @@
+"""CPU-only tests of bounded pending order and actual exclusive-lock ownership."""
+import math
+import threading
+import time
+import unittest
+
+from serve.inference_queue import InferenceQueue, QueueFull, Ticket, scheduling_class
+
+
+class QueueTests(unittest.TestCase):
+    def setUp(self):
+        self.now = 100.0
+        self.queue = InferenceQueue(clock=lambda: self.now)
+        self.fifo = threading.Lock()
+
+    def take(self, ticket):
+        self.assertTrue(self.queue.acquire(ticket, self.fifo, 0))
+        self.assertTrue(self.fifo.locked())
+        self.fifo.release()
+
+    def test_default_and_self_demotion_only(self):
+        self.assertEqual(scheduling_class(None), "normal")
+        self.assertEqual(scheduling_class({}), "normal")
+        self.assertEqual(scheduling_class({"strata_scheduling": {"class": "background"}}), "background")
+        self.assertEqual(scheduling_class({"strata_scheduling": {"class": "normal"}}), "normal")
+        for metadata in ({"class": "interactive"}, {"class": "normal", "priority": 999},
+                         {"class": 1}, {"class": "normal", "trusted": True}, None, "background"):
+            with self.subTest(metadata=metadata), self.assertRaises(ValueError):
+                scheduling_class({"strata_scheduling": metadata})
+
+    def test_fifo_ties_within_class(self):
+        first, second = self.queue.enqueue(), self.queue.enqueue()
+        self.assertFalse(self.queue.acquire(second, self.fifo, 0))
+        self.take(first)
+        self.take(second)
+
+    def test_later_normal_precedes_waiting_background(self):
+        self.fifo.acquire()
+        background = self.queue.enqueue("background")
+        self.assertFalse(self.queue.acquire(background, self.fifo, 0))
+        self.now += .5
+        normal = self.queue.enqueue("normal")
+        self.assertTrue(self.fifo.locked())
+        self.assertEqual(self.queue.snapshot()["pending"], 2)
+        self.fifo.release()
+        self.assertFalse(self.queue.acquire(background, self.fifo, 0))
+        self.take(normal)
+        self.take(background)
+
+    def test_bounded_boost_cannot_starve_older_background(self):
+        background = self.queue.enqueue("background")
+        early = []
+        for i in range(1, 11):
+            self.now = 100 + i / 10
+            early.append(self.queue.enqueue())
+        self.now = 102.001
+        late = self.queue.enqueue()
+        for ticket in early:
+            self.take(ticket)
+        self.assertFalse(self.queue.acquire(late, self.fifo, 0))
+        self.take(background)
+        self.take(late)
+
+    def test_zero_boost_is_global_fifo(self):
+        queue = InferenceQueue(normal_boost_seconds=0, clock=lambda: self.now)
+        first = queue.enqueue("background")
+        second = queue.enqueue("normal")
+        self.assertFalse(queue.acquire(second, self.fifo, 0))
+        self.assertTrue(queue.acquire(first, self.fifo, 0))
+        self.fifo.release()
+        self.assertTrue(queue.acquire(second, self.fifo, 0))
+        self.fifo.release()
+
+    def test_trained_cost_orders_waiting_requests_with_bounded_delay(self):
+        costly = self.queue.enqueue(predicted_s=1000)
+        self.now += .1
+        short = self.queue.enqueue(predicted_s=.5)
+        self.assertEqual(costly.cost_delay_s, 30)
+        self.assertFalse(self.queue.acquire(costly, self.fifo, 0))
+        self.take(short)
+        self.take(costly)
+
+    def test_unknown_cost_has_no_cold_start_bonus(self):
+        unknown = self.queue.enqueue()
+        self.now += .1
+        known = self.queue.enqueue(predicted_s=.2)
+        self.assertEqual(unknown.cost_delay_s, 30)
+        self.assertFalse(self.queue.acquire(unknown, self.fifo, 0))
+        self.take(known)
+        self.take(unknown)
+
+    def test_total_class_and_cost_cap_protects_old_unknown_background(self):
+        old = self.queue.enqueue("background")
+        self.now += 32.001
+        new = self.queue.enqueue("normal", predicted_s=0)
+        self.assertFalse(self.queue.acquire(new, self.fifo, 0))
+        self.take(old)
+        self.take(new)
+
+    def test_cost_delay_disabled_preserves_class_order(self):
+        queue = InferenceQueue(max_cost_delay_s=0, clock=lambda: self.now)
+        first = queue.enqueue(predicted_s=999)
+        self.now += .1
+        second = queue.enqueue(predicted_s=0)
+        self.assertTrue(queue.acquire(first, self.fifo, 0))
+        self.fifo.release()
+        self.assertTrue(queue.acquire(second, self.fifo, 0))
+        self.fifo.release()
+
+    def test_no_arrival_bypasses_older_eligible_ticket(self):
+        first = self.queue.enqueue()
+        self.now += 1
+        arrival = self.queue.enqueue()
+        self.assertFalse(self.queue.acquire(arrival, self.fifo, 0))
+        self.assertFalse(self.fifo.locked())
+        self.take(first)
+        self.take(arrival)
+
+    def test_timeout_retains_ticket_and_owner(self):
+        self.fifo.acquire()
+        ticket = self.queue.enqueue()
+        self.assertFalse(self.queue.acquire(ticket, self.fifo, .01))
+        self.assertTrue(self.fifo.locked())
+        self.assertEqual(self.queue.snapshot()["pending"], 1)
+        self.queue.discard(ticket)
+        self.assertTrue(self.fifo.locked())
+        self.fifo.release()
+
+    def test_cancelled_head_never_acquires_or_blocks_successor(self):
+        first, second = self.queue.enqueue(), self.queue.enqueue()
+        cancel = threading.Event()
+        cancel.set()
+        self.assertFalse(self.queue.acquire(first, self.fifo, 0, cancel))
+        self.assertFalse(self.fifo.locked())
+        self.assertTrue(self.queue.discard(first))
+        self.assertFalse(self.queue.discard(first))
+        self.take(second)
+
+    def test_exact_ticket_identity_and_bounded_capacity(self):
+        queue = InferenceQueue(max_pending=1, clock=lambda: self.now)
+        original = queue.enqueue()
+        forged = Ticket(original.scheduling_class, original.arrived, original.sequence, original.rank)
+        self.assertFalse(queue.discard(forged))
+        self.assertFalse(queue.acquire(forged, self.fifo, 0))
+        with self.assertRaises(QueueFull):
+            queue.enqueue()
+        self.assertEqual(queue.snapshot()["pending"], 1)
+        queue.discard(original)
+        self.assertEqual(queue.snapshot()["pending"], 0)
+
+    def test_cancelled_tail_does_not_accumulate_history(self):
+        anchor = self.queue.enqueue()
+        for _ in range(500):
+            ticket = self.queue.enqueue()
+            self.queue.discard(ticket)
+        self.assertLessEqual(len(self.queue._heap), 34)
+        self.take(anchor)
+
+    def test_actual_thread_waits_for_existing_owner(self):
+        self.fifo.acquire()
+        ticket = self.queue.enqueue()
+        entered, acquired = threading.Event(), threading.Event()
+        errors = []
+
+        def worker():
+            entered.set()
+            try:
+                if self.queue.acquire(ticket, self.fifo, 1):
+                    acquired.set()
+                    self.fifo.release()
+            except BaseException as error:
+                errors.append(error)
+            finally:
+                self.queue.discard(ticket)
+
+        thread = threading.Thread(target=worker)
+        thread.start()
+        self.assertTrue(entered.wait(1))
+        self.assertFalse(acquired.wait(.03))
+        self.assertTrue(self.fifo.locked())
+        self.fifo.release()  # A control owner need not know about the new queue.
+        thread.join(2)
+        self.assertFalse(thread.is_alive())
+        self.assertFalse(errors)
+        self.assertTrue(acquired.is_set())
+        self.assertEqual(self.queue.snapshot()["pending"], 0)
+
+    def test_cancel_interrupts_long_wait_without_unlocking_owner(self):
