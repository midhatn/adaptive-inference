+    def __init__(self,tok):
+        super().__init__(tok,'ok',max_context=65536)
+        self.proc=object(); self.native_sampling=[]
+
+    def generate(self,ids,max_new,sampling,cancel,embeddings=None,park=None):
+        self.native_sampling.append(copy.deepcopy(sampling))
+        assert park is not None and park.proc is self.proc
+        try: yield from super().generate(ids,max_new,sampling,cancel,embeddings)
+        finally:
+            self.last={'generated':3,'prompt_ms':1.,'decode_ms':1.,'finish':'stop',
