+        svc=server.Service(ParkingEngine(tok),tok,
+                           ChatTemplate(Path(server.ROOT)/'serve/chat_template.jinja'))
+        svc.configure_inference_scheduling({'enabled':True,'max_pending':4})
+        svc.idle_parking=server.IdleParking({'enabled':True})
+        svc.request_parking=RequestParking({'enabled':True,'directory':str(Path(tempfile.gettempdir()).resolve())})
+        return svc
+
+    def test_http_equivalent_requests_share_feedback_across_effective_seeds(self):
+        for seed_mode in ('absent','zero','explicit'):
+            with self.subTest(seed_mode=seed_mode):
+                svc=self.service(); request_seeds=[]
+                # Only hardware identity/footprint are fixtures. The actual
+                # effective_sampling method must generate/preserve native seeds.
+                with mock.patch.object(svc,'_parking_identity',return_value={'cpu_fixture':True}), \
+                     mock.patch.object(svc,'_parking_footprint',return_value={}), \
+                     mock.patch.object(svc,'start_telemetry'), \
