index 0000000000000000000000000000000000000000..d12d09a8d763e51b77f0257efe1740c438f065c1
--- /dev/null
+++ b/serve/inference_queue.py
@@ -0,0 +1,167 @@
+"""Opt-in ordering of waiting inference calls; never owns lifecycle or memory.
+
+Design reference (no source copied): NVIDIA Dynamo, Apache-2.0,
+868de572ad9e10e2effb16bb0cff57f3973ca1e8,
+lib/kv-router/src/scheduling/policy_queue.rs:941-952. Its FCFS policy shifts
+arrival time by a priority offset. Here the operator bounds that offset and
+clients can only demote themselves. There are no strict tiers or preemption.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import heapq
+import itertools
+import math
+import threading
+import time
+
+
+CLASSES = ("normal", "background")
+MAX_BOOST_SECONDS = 10.0
+MAX_PENDING = 4096
+
+
+def scheduling_class(request):
+    """Normal is the default. A public hint can only request background service."""
+    if request is None:
+        return "normal"
+    if not isinstance(request, dict):
+        raise ValueError("inference request must be an object")
+    if "strata_scheduling" not in request:
+        return "normal"
+    metadata = request["strata_scheduling"]
+    if (not isinstance(metadata, dict) or set(metadata) != {"class"}
+            or not isinstance(metadata["class"], str) or metadata["class"] not in CLASSES):
+        raise ValueError("strata_scheduling accepts only class normal or background")
+    return metadata["class"]
+
+
+def _finite(value):
+    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)
+
+
+class QueueFull(ValueError):
+    """The configured pending bound is full; no ticket or lock was acquired."""
+
+
+@dataclass(frozen=True, eq=False)
+class Ticket:
+    scheduling_class: str
+    arrived: float
+    sequence: int
+    rank: float
+    predicted_s: float | None = None
+    cost_delay_s: float = 0.0
+
+
+class InferenceQueue:
+    """Bounded waiting tickets sharing the service's existing exclusive lock.
+
+    Admission, tool leases, active work and lock release remain with the service.
+    A ticket stays queued until it actually acquires that lock. This lets a
+    later normal request precede waiting background work while an owner runs.
+    Any request older by more than the class plus cost caps precedes new work;
+    this is an ordering property, not a wall-clock completion guarantee.
+    """
+
+    def __init__(self, *, normal_boost_seconds=2.0, max_pending=128,
+                 max_cost_delay_s=30.0, clock=time.monotonic):
+        if not _finite(normal_boost_seconds) or not 0 <= normal_boost_seconds <= MAX_BOOST_SECONDS:
+            raise ValueError("normal_boost_seconds must be finite and between 0 and 10")
+        if type(max_pending) is not int or not 1 <= max_pending <= MAX_PENDING:
+            raise ValueError("max_pending must be an integer between 1 and 4096")
+        if not _finite(max_cost_delay_s) or not 0 <= max_cost_delay_s <= 300:
+            raise ValueError("max_cost_delay_s must be finite and between 0 and 300")
+        self.normal_boost_seconds = float(normal_boost_seconds)
+        self.max_cost_delay_s = float(max_cost_delay_s)
+        self.max_pending, self.clock = max_pending, clock
+        self._changed = threading.Condition()
+        self._sequence = itertools.count()
+        self._pending = set()
+        self._heap = []
+        self._admitted = self._discarded = self._rejected = 0
+
+    def enqueue(self, scheduling_class="normal", predicted_s=None):
+        if not isinstance(scheduling_class, str) or scheduling_class not in CLASSES:
+            raise ValueError("scheduling class must be normal or background")
+        if predicted_s is not None and (not _finite(predicted_s) or predicted_s < 0):
+            raise ValueError("predicted_s must be None or a finite nonnegative cost")
+        now = self.clock()
+        if not _finite(now):
+            raise ValueError("queue clock must be finite")
+        with self._changed:
+            if len(self._pending) >= self.max_pending:
+                self._rejected += 1
+                raise QueueFull("inference pending queue is full")
+            background_delay = self.normal_boost_seconds if scheduling_class == "background" else 0.0
+            # An unknown/cold context receives no cheap-task scheduling bonus.
+            # Only the host's trained, context-valid estimate belongs here;
+            # request metadata cannot supply a prediction or change these caps.
+            cost_delay = self.max_cost_delay_s if predicted_s is None else min(self.max_cost_delay_s, predicted_s)
+            ticket = Ticket(scheduling_class, now, next(self._sequence),
+                            now + background_delay + cost_delay, predicted_s, cost_delay)
+            self._pending.add(ticket)
+            heapq.heappush(self._heap, (ticket.rank, ticket.sequence, ticket))
+            self._changed.notify_all()
+            return ticket
+
+    def _head(self):
+        while self._heap and self._heap[0][2] not in self._pending:
+            heapq.heappop(self._heap)
+        return self._heap[0][2] if self._heap else None
+
+    def acquire(self, ticket, fifo, timeout, cancel=None):
+        """Try until timeout; false leaves the ticket queued for the next wait.
+
+        A caller must discard its ticket in finally. Existing owners may release
+        fifo without notifying this object, so bounded polling is intentional.
+        A canceled/removed ticket returns false and can never acquire fifo.
+        """
+        if not _finite(timeout) or timeout < 0:
+            raise ValueError("queue wait timeout must be finite and nonnegative")
+        deadline = time.monotonic() + timeout
+        with self._changed:
+            while ticket in self._pending:
+                if cancel is not None and cancel.is_set():
+                    return False
+                if self._head() is ticket and fifo.acquire(blocking=False):
+                    self._pending.remove(ticket)
+                    heapq.heappop(self._heap)
+                    self._admitted += 1
+                    self._changed.notify_all()
+                    return True
+                left = deadline - time.monotonic()
+                if left <= 0:
+                    return False
+                self._changed.wait(min(.05, left))
+            return False
+
+    def discard(self, ticket):
+        """Idempotently remove this exact ticket; never release another owner."""
+        with self._changed:
+            if ticket not in self._pending:
+                return False
+            self._pending.remove(ticket)
+            self._discarded += 1
+            self._head()
+            # Cancellation away from the heap head must not accumulate an
+            # unbounded tombstone history during one long running request.
+            if len(self._heap) > 2 * len(self._pending) + 32:
+                self._heap = [(t.rank, t.sequence, t) for t in self._pending]
+                heapq.heapify(self._heap)
+            self._changed.notify_all()
+            return True
+
+    def snapshot(self):
+        with self._changed:
+            now = self.clock()
+            oldest = min((t.arrived for t in self._pending), default=now)
+            return {"enabled": True, "scope": "waiting_single_owner_inference",
+                    "normal_boost_seconds": self.normal_boost_seconds, "max_pending": self.max_pending,
+                    "max_cost_delay_s": self.max_cost_delay_s,
+                    "maximum_overtake_seconds": self.normal_boost_seconds + self.max_cost_delay_s,
+                    "pending": len(self._pending),
+                    "classes": {name: sum(t.scheduling_class == name for t in self._pending) for name in CLASSES},
+                    "oldest_wait_seconds": max(0.0, now - oldest),
+                    "admitted": self._admitted, "discarded": self._discarded, "rejected": self._rejected,
+                    "preemption": False, "capacity_reservation": False}
