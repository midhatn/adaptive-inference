+                    httpd=server.serve(svc,port=0)
+                    try:
+                        for kind in ('normal','background'):
+                            for repetition in range(4):
+                                body={'messages':[{'role':'user','content':'Calculate 19 times 23.'}],
+                                      'stream':False,'max_tokens':10923,'reasoning_effort':'high',
+                                      'reasoning_budget_tokens':8192,'experimental_speed_projection':False,
+                                      'strata_tune':{'pcie_frac':.37},'strata_scheduling':{'class':kind}}
+                                if seed_mode=='zero': body['seed']=0
+                                elif seed_mode=='explicit': body['seed']=1000+len(request_seeds)
+                                request_seeds.append(body.get('seed'))
+                                original=copy.deepcopy(body)
+                                conn=http.client.HTTPConnection('127.0.0.1',httpd.server_address[1],timeout=3)
+                                try:
+                                    conn.request('POST','/v1/chat/completions',json.dumps(body),{'Content-Type':'application/json'})
+                                    response=conn.getresponse(); reply=json.loads(response.read())
+                                    self.assertEqual(response.status,200,reply)
+                                    self.assertEqual(reply['choices'][0]['finish_reason'],'stop')
+                                finally: conn.close()
+                                self.assertEqual(body,original)
+                                until=time.monotonic()+2
+                                while svc.admission_reserved and time.monotonic()<until: time.sleep(.005)
+                                row=svc.history[-1]['scheduling']
+                                self.assertEqual(row['prediction_samples'],repetition)
+                                self.assertTrue(row['trained'])
+                                if repetition==3:
+                                    self.assertEqual(row['prediction_reason'],'measured')
+                                    self.assertTrue(math.isfinite(row['predicted_execution_s']))
+                                    self.assertGreater(row['predicted_execution_s'],0)
+                        self.assertEqual(svc.request_costs.status()['groups'],2)
+                        self.assertEqual(svc.request_costs.status()['observations'],8)
+                        actual=[row['seed'] for row in svc.engine.native_sampling]
+                        expected=request_seeds if seed_mode=='explicit' else list(range(101,109))
+                        self.assertEqual(actual,expected,'native seeds must remain unchanged by latency grouping')
