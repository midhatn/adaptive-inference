+"""Real HTTP requests through scheduler + lifecycle preparation, without models."""
+import http.client
+import json
+from pathlib import Path
+import socket
+import threading
+import time
+import unittest
+from unittest import mock
+
+from serve import server
+from serve.frontend import ChatTemplate
+from serve.server import IdleParking
+from serve.resource_lease import ToolLeases
+
+
+class HoldingEngine(server.MockEngine):
+    def __init__(self, tok):
+        super().__init__(tok, 'ok', max_context=65536)
+        self.proc = object()
+        self.started, self.release = threading.Event(), threading.Event()
+        self.dispatches = []
+
+    def unload(self):
+        raise AssertionError('reserved fixture must not unload')
+
+    def generate(self, ids, max_new, sampling, cancel, embeddings=None):
+        text = self.tok.decode(ids)
+        self.dispatches.append(text)
+        if len(self.dispatches) == 1:
+            self.started.set()
+            if not self.release.wait(4):
+                raise RuntimeError('fixture owner release timed out')
+        yield from super().generate(ids, max_new, sampling, cancel, embeddings)
+        self.last = {'generated': 3, 'prompt_ms': 1., 'decode_ms': 1., 'finish': 'stop',
+                     'prompt_read': len(ids), 'reused': 0}
+
+
+class Call:
+    def __init__(self, port, label, kind=None):
+        self.conn = http.client.HTTPConnection('127.0.0.1', port, timeout=5)
+        req = {'messages': [{'role':'user','content':label}], 'max_tokens':32,
+               'reasoning_effort':'none', 'stream':False}
+        if kind: req['strata_scheduling'] = {'class':kind}
+        self.conn.request('POST','/v1/chat/completions', json.dumps(req), {'Content-Type':'application/json'})
+        self.socket = self.conn.sock
+        self.done, self.result, self.error = threading.Event(), None, None
+        def read():
+            try:
+                response = self.conn.getresponse()
+                self.result = (response.status, json.loads(response.read()))
+            except BaseException as exc: self.error = exc
+            finally: self.done.set(); self.conn.close()
+        self.thread = threading.Thread(target=read); self.thread.start()
+
+    def cancel(self):
+        try: self.socket.shutdown(socket.SHUT_RDWR)
+        except OSError: pass
+        self.conn.close()
+
+
+class PreparationScheduling(unittest.TestCase):
+    def service(self, enabled=True):
+        tok = server.ByteTokenizer()
+        svc = server.Service(HoldingEngine(tok), tok,
+            ChatTemplate(Path(server.ROOT)/'serve/chat_template.jinja'))
+        svc.configure_inference_scheduling({'enabled':enabled,'normal_boost_seconds':10.,
+                                          'max_cost_delay_s':0.,'max_pending':4})
+        svc.idle_parking = IdleParking({'enabled':True})
+        with mock.patch.dict('os.environ',{'STRATA_RESOURCE_LEASE_TOKEN':'isolated-preparation-test-token-'*3}):
+            svc.tool_leases = ToolLeases({'enabled':True})
+        return svc
+
+    def wait(self, predicate, seconds=2):
+        until = time.monotonic()+seconds
+        while not predicate():
+            if time.monotonic() >= until: self.fail('combined HTTP preparation transition timed out')
+            time.sleep(.005)
+
+    def test_real_http_waiters_reach_scheduler_with_idle_admission_and_leases(self):
+        svc = self.service()
+        admitted = []
+        actual_admit = svc._admit_loaded
+        def admit(cancel):
+            self.assertTrue(svc.fifo.locked())
+            admitted.append(threading.get_ident())
+            yield from actual_admit(cancel)
+        patch = mock.patch.object(svc, '_admit_loaded', side_effect=admit)
+        patch.start(); self.addCleanup(patch.stop)
+        with mock.patch.object(svc, 'start_telemetry'):
+            httpd = server.serve(svc, port=0)
+        calls = []
+        try:
+            port = httpd.server_address[1]
+            calls.append(Call(port,'owner'))
+            self.assertTrue(svc.engine.started.wait(2))
+            calls.append(Call(port,'background','background'))
+            self.wait(lambda: svc.inference_queue.snapshot()['pending'] == 1)
+            calls.append(Call(port,'normal','normal'))
+            self.wait(lambda: svc.inference_queue.snapshot()['pending'] == 2)
+            calls.append(Call(port,'cancelled','background'))
+            self.wait(lambda: svc.inference_queue.snapshot()['pending'] == 3)
+            self.assertEqual(svc.preparing_requests, 4)
+            self.assertEqual(svc.admission_reserved, 4)
+            self.assertEqual(len(svc.engine.dispatches), 1)
+            self.assertEqual(svc.unload(), 'busy')
+            calls[-1].cancel()
+            self.wait(lambda: svc.inference_queue.snapshot()['pending'] == 2)
+            self.assertEqual(len(svc.engine.dispatches), 1)
+            self.assertTrue(svc.fifo.locked())
+            svc.engine.release.set()
+            self.wait(lambda: all(c.done.is_set() for c in calls[:3]))
+            for call in calls[:3]:
+                self.assertIsNone(call.error)
+                self.assertEqual(call.result[0], 200)
+            rows = list(svc.history)
+            self.assertEqual([r['scheduling']['class'] for r in rows], ['normal','normal','background'])
+            self.assertEqual(len(svc.engine.dispatches), 3)
+            self.assertEqual(len(admitted), 3, 'each native request must still pass owned admission')
+            self.assertTrue(all('cancelled' not in text for text in svc.engine.dispatches))
+            self.wait(lambda: svc.admission_reserved == 0 and svc.preparing_requests == 0)
+            self.assertFalse(svc.fifo.locked())
+            self.assertEqual(svc.inference_queue.snapshot()['pending'], 0)
+        finally:
+            svc.engine.release.set()
+            for call in calls: call.cancel(); call.thread.join(5)
+            httpd.shutdown(); httpd.server_close()
+
+    def test_disabled_scheduler_and_explicit_load_still_wait_for_fifo(self):
+        for enabled, outer in ((False,True),(True,False)):
+            with self.subTest(enabled=enabled,outer=outer):
+                svc = self.service(enabled)
+                cancel = threading.Event()
+                svc.fifo.acquire()
+                reservation = svc.preparation_reservation() if outer else None
+                if reservation: reservation.__enter__()
+                events = svc.load_events(cancel)
+                try:
+                    self.assertEqual(next(events), ('ping',None))
+                    self.assertTrue(svc.fifo.locked())
+                    self.assertEqual(svc.engine.dispatches, [])
+                    cancel.set()
+                    with self.assertRaises(server.RequestParkCancelled): next(events)
+                finally:
+                    events.close()
+                    if reservation: reservation.__exit__(None,None,None)
+                    self.assertTrue(svc.fifo.locked())
+                    svc.fifo.release()
+                self.assertEqual(svc.preparing_requests, 0)
+
+    def test_pending_lifecycle_or_resource_return_keeps_original_gate(self):
+        for name,value in (('idle_parked',{}), ('memory_loading',True), ('memory_pending',{}), ('memory_live_pending',{}),
+                           ('tool_resume',{}), ('tool_resuming',True), ('tool_resident',{})):
+            with self.subTest(state=name):
+                svc = self.service(); setattr(svc,name,value)
+                cancel = threading.Event(); svc.fifo.acquire()
+                with svc.preparation_reservation():
+                    events = svc.load_events(cancel)
+                    try:
+                        self.assertEqual(next(events), ('ping',None))
+                        self.assertTrue(svc.fifo.locked())
+                        cancel.set()
+                        with self.assertRaises(server.RequestParkCancelled): next(events)
+                    finally: events.close()
+                self.assertEqual(svc.preparing_requests, 0)
+                self.assertEqual(svc.engine.dispatches, [])
+                self.assertTrue(svc.fifo.locked()); svc.fifo.release()
+
+    def test_preparation_snapshot_does_not_authorize_later_generation_or_vision(self):
+        svc = self.service(); cancel = threading.Event()
+        with svc.preparation_reservation():
+            self.assertEqual(list(svc.load_events(cancel)), [])
+            def unavailable(current_cancel):
+                self.assertTrue(svc.fifo.locked())
+                raise server.GpuBusy('resource state changed after preparation')
+                yield
+            with mock.patch.object(svc, '_admit_loaded', side_effect=unavailable) as gate:
+                with self.assertRaises(server.GpuBusy):
+                    list(svc.run([1],False,None,32,{},cancel))
+                with self.assertRaises(server.GpuBusy):
+                    with svc._vision_turn(cancel):
+                        self.fail('unadmitted vision turn entered')
+                self.assertEqual(gate.call_count, 2)
+        self.assertEqual(svc.engine.dispatches, [])
+        self.assertFalse(svc.fifo.locked())
+        self.assertEqual(svc.preparing_requests, 0)
+        self.assertEqual(svc.inference_queue.snapshot()['pending'], 0)
+
+    def test_real_http_new_request_cannot_bypass_an_owned_tool_lease(self):
+        from serve.test_resource_lease import acquire_request, capacity
+        svc = self.service()
+        with mock.patch.dict('os.environ',{'STRATA_RESOURCE_LEASE_TOKEN':'isolated-preparation-test-token-'*3}):
+            svc.tool_leases = ToolLeases({'enabled':True},clock=lambda:0)
+        svc.tool_leases.acquire(acquire_request(),capacity(),100)
+        with mock.patch.object(svc, 'start_telemetry'):
+            httpd = server.serve(svc, port=0)
+        call = None
+        try:
+            call = Call(httpd.server_address[1], 'leased-background','background')
+            self.wait(lambda: svc.admission_reserved == 1)
+            self.assertTrue(svc.tool_leases.blocked())
+            self.assertEqual(svc.inference_queue.snapshot()['pending'], 0)
+            self.assertEqual(svc.engine.dispatches, [])
+            self.assertFalse(svc.fifo.locked())
+            call.cancel()
+            self.wait(lambda: svc.admission_reserved == 0)
+            self.assertTrue(svc.tool_leases.blocked())
+            self.assertEqual(svc.preparing_requests, 0)
+        finally:
+            if call: call.cancel(); call.thread.join(5)
+            httpd.shutdown(); httpd.server_close()
+
+
+if __name__ == '__main__': unittest.main()
diff --git a/tests/test_request_costs.py b/tests/test_request_costs.py
new file mode 100644
index 0000000000000000000000000000000000000000..42aa5219a699e45f922629af71cbfeaab67f6f0d
--- /dev/null
+++ b/tests/test_request_costs.py
@@ -0,0 +1,127 @@
+"""Behavioral tests for the queue's bounded latency feedback, without a model."""
+import concurrent.futures
+import math
+import unittest
+
+from serve.request_costs import RequestCostModel
+
+
+class RequestCostTests(unittest.TestCase):
+    def test_cold_and_sparse_do_not_claim_a_cost(self):
+        model = RequestCostModel()
+        self.assertEqual(model.predict("runtime", now=0)["reason"], "cold")
+        for now in (1, 2):
+            self.assertTrue(model.observe("runtime", 10, now=now))
+            self.assertIsNone(model.predict("runtime", now=now)["estimate_s"])
+        model.observe("runtime", 10, now=3)
+        self.assertEqual(model.predict("runtime", now=3)["estimate_s"], 10)
+
+    def test_sudden_slowdown_is_immediate_and_recovery_is_cautious(self):
+        model = RequestCostModel(max_samples=3)
+        for now in range(3):
+            model.observe("r", 10, now=now)
+        model.observe("r", 100, now=3)
+        self.assertEqual(model.predict("r", now=3)["estimate_s"], 100)
+        for now in (4, 5, 6):
+            model.observe("r", 10, now=now)
+        prediction = model.predict("r", now=6)
+        self.assertEqual(prediction["p90_s"], 10)
+        self.assertAlmostEqual(prediction["peak_s"], 10 + 90 * math.exp(-3 / 60))
+        self.assertGreater(prediction["estimate_s"], 95)
+        model.observe("r", 10, now=606)
+        self.assertLess(model.predict("r", now=606)["estimate_s"], 10.01)
+
+    def test_reading_idle_estimate_does_not_make_a_heavy_job_free(self):
+        model = RequestCostModel()
+        for now in range(3):
+            model.observe("r", 90, now=now)
+        for now in range(3, 900):
+            self.assertEqual(model.predict("r", now=now)["estimate_s"], 90)
+
+    def test_expiry_discards_evidence_and_relearning_starts_cold(self):
+        model = RequestCostModel(ttl_s=10)
+        for now in range(3):
+            model.observe("r", 90, now=now)
+        self.assertEqual(model.predict("r", now=13)["reason"], "expired")
+        model.observe("r", 2, now=14)
+        result = model.predict("r", now=14)
+        self.assertEqual(result["samples"], 1)
+        self.assertIsNone(result["estimate_s"])
+        self.assertEqual(result["peak_s"], 2)
+
+    def test_fresh_minimum_is_rechecked_as_old_samples_expire(self):
+        model = RequestCostModel(ttl_s=10)
+        for now in (0, 5, 10):
+            model.observe("r", 20, now=now)
+        self.assertEqual(model.predict("r", now=10)["samples"], 3)
+        result = model.predict("r", now=11)
+        self.assertEqual(result["samples"], 2)
+        self.assertIsNone(result["estimate_s"])
+
+    def test_context_changes_cannot_inherit_old_latency(self):
+        model = RequestCostModel()
+        for now in range(3):
+            model.observe("model-A-route-A-shape-A", 1, now=now)
+        for key in ("model-B-route-A-shape-A", "model-A-route-B-shape-A", "model-A-route-A-shape-B"):
+            self.assertIsNone(model.predict(key, now=3)["estimate_s"])
+
+    def test_fast_failure_is_not_learned_as_a_fast_success(self):
+        model = RequestCostModel()
+        for now in range(3):
+            model.observe("r", 20, now=now)
+        self.assertFalse(model.observe("r", .001, now=3, success=False))
+        self.assertIsNone(model.predict("r", now=3)["estimate_s"])
+        self.assertEqual(model.status()["observations"], 3)
+
+    def test_invalid_values_do_not_poison_valid_measurements(self):
+        model = RequestCostModel()
+        for now in range(3):
+            model.observe("r", 20, now=now)
+        for value in (float("nan"), float("inf"), -1, 0, True, "1", 86401):
+            self.assertFalse(model.observe("r", value, now=3))
+        for stamp in (float("nan"), float("inf"), -1, True):
+            self.assertFalse(model.observe("r", 2, now=stamp))
+            self.assertIsNone(model.predict("r", now=stamp)["estimate_s"])
+        self.assertEqual(model.predict("r", now=3)["estimate_s"], 20)
+
+    def test_clock_regression_does_not_rewrite_history(self):
+        model = RequestCostModel()
+        for now in (4, 5, 6):
+            model.observe("r", 20, now=now)
+        self.assertFalse(model.observe("r", 1, now=5))
+        self.assertEqual(model.predict("r", now=5)["reason"], "clock_regressed")
+        self.assertEqual(model.predict("r", now=6)["estimate_s"], 20)
+
+    def test_storage_is_bounded_and_evicted_groups_restart_cold(self):
+        model = RequestCostModel(max_groups=2, max_samples=3)
+        for now in range(20):
+            model.observe("a", now + 1, now=now)
+        self.assertEqual(model.predict("a", now=20)["samples"], 3)
+        model.observe("b", 2, now=20)
+        model.observe("c", 3, now=21)
+        self.assertEqual(model.status()["groups"], 2)
+        self.assertEqual(model.status()["evicted"], 1)
+        self.assertEqual(model.predict("a", now=21)["reason"], "cold")
+
+    def test_status_does_not_expose_opaque_context_keys(self):
+        model = RequestCostModel()
+        model.observe("private-context-identity", 2, now=0)
+        self.assertNotIn("private-context-identity", repr(model.status()))
+
+    def test_simultaneous_request_threads_preserve_sample_counts(self):
+        model = RequestCostModel(max_samples=256)
+        with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
+            results = list(pool.map(lambda _: model.observe("r", 2, now=1), range(100)))
+        self.assertTrue(all(results))
+        self.assertEqual(model.predict("r", now=1)["samples"], 100)
+        self.assertEqual(model.status()["observations"], 100)
+
+    def test_bad_configuration_is_refused(self):
+        for args in ({"decay_s": 0}, {"ttl_s": float("nan")}, {"min_samples": 2},
+                     {"max_groups": 0}, {"max_samples": 2}, {"max_samples": 257}):
+            with self.subTest(args=args), self.assertRaises(ValueError):
+                RequestCostModel(**args)
+
+
+if __name__ == "__main__":
+    unittest.main()
