+def inference_scheduling_from_config(config, cfg=None):
+    """Validate an opt-in pending queue before constructing an engine."""
+    if config is None:
+        return None, None
+    allowed = {"enabled", "normal_boost_seconds", "max_pending", "max_cost_delay_s", "cost_model"}
+    if not isinstance(config, dict) or set(config) - allowed or type(config.get("enabled", False)) is not bool:
+        raise ValueError("inference_scheduling accepts enabled and bounded queue/cost settings")
+    if not config.get("enabled", False):
+        return None, None
+    cfg = cfg or {}
+    args = configured_engine_args(cfg)
+    if (cfg.get("parallel") not in (None, False, 0, 1) or cfg.get("replicas")
+            or any(flag in args for flag in ("--batch", "--slots", "--batch-groups"))):
+        raise ValueError("inference_scheduling currently requires one non-batched engine")
+    from serve.inference_queue import InferenceQueue
+    from serve.request_costs import RequestCostModel
+    costs = config.get("cost_model", {})
+    if not isinstance(costs, dict) or set(costs) - {"decay_s", "ttl_s", "min_samples", "max_groups", "max_samples"}:
+        raise ValueError("invalid inference_scheduling cost_model settings")
+    queue = InferenceQueue(**{k: config[k] for k in ("normal_boost_seconds", "max_pending", "max_cost_delay_s")
+                              if k in config})
+    return queue, RequestCostModel(**costs)
+
+
 class Service:
     def __init__(self, engine: Engine, tokenizer, template: ChatTemplate, model_name: str = "qwen3.8-flash-next",
                  vision: Vision | None = None, sampling_defaults: dict | None = None,
@@ -4158,6 +4182,11 @@ class Service:
         # while a model is loading or a request is between MCP rounds; the engine's own slots remain unchanged.
         self.max_queue: int | None = None
         self.queue_timeout_s: float | None = None
+        self.inference_queue = self.request_costs = None  # opt-in; no model or key construction on the default path
+        self.cost_runtime_lock = None
+        self.cost_runtime_proc = None
+        self.cost_runtime_generation = 0
+        self.cost_observer_errors = 0
         self.admission_reserved = 0
         self.admission_rejected = 0
         self.queue_timeouts = 0
@@ -4261,9 +4290,70 @@ class Service:
         return not hasattr(self.engine, "alive") or self.engine.alive()
 
     def admission_limit(self) -> int | None:
-        if self.max_queue is None:
+        limit = None if self.max_queue is None else max(1, int(getattr(self.engine, "batch", 0) or 0)) + self.max_queue
+        # A lifecycle owner can hold the lock while every HTTP call is pending.
+        # Reserve before SSE against the ticket bound, including the active call.
+        if self.inference_queue is not None:
+            limit = self.inference_queue.max_pending if limit is None else min(limit, self.inference_queue.max_pending)
+        return limit
+
+    def configure_inference_scheduling(self, config, *, prepared=None):
+        queue, costs = prepared if prepared is not None else inference_scheduling_from_config(config)
+        if queue is not None and getattr(self.engine, "batch", 0):
+            raise ValueError("inference_scheduling does not support a batched engine")
+        if self.status.get("busy") or self.status.get("queued") or self.admission_reserved:
+            raise ValueError("inference_scheduling cannot change while requests are admitted")
+        self.inference_queue, self.request_costs = queue, costs
+        self.cost_runtime_lock = threading.Lock() if queue is not None else None
+        self.cost_runtime_proc, self.cost_runtime_generation = None, 0
+
+    def inference_scheduling_status(self):
+        if self.inference_queue is None:
+            return {"enabled": False}
+        return {"enabled": True, "scope": "pending_single_engine_inference", "preemption": False,
+                "queue": self.inference_queue.snapshot(), "cost_model": self.request_costs.status(),
+                "observer_errors": self.cost_observer_errors}
+
+    def _request_cost_key(self, prompt_tokens, max_new, thinking, budget, sampling, scheduling_class):
+        """Opaque runtime and bounded request-shape identity; no prompt or client identity."""
+        proc = getattr(self.engine, "proc", None)
+        if proc is None or self.request_costs is None:
+            return None
+        with self.cost_runtime_lock:
+            if proc is not self.cost_runtime_proc:
+                self.cost_runtime_proc = proc
+                self.cost_runtime_generation += 1
+            generation = self.cost_runtime_generation
+        values = dict(sampling or {})
+        # A seed identifies RNG draws, not a different latency population. Parking
+        # selects a fresh effective seed after queueing, so retaining it here
+        # would separate prediction from observation and prevent reuse forever.
+        # Remove it only from this observer copy; native sampling and replay keep
+        # their exact explicit or generated seed. Quality/route controls remain.
+        values.pop("seed", None)
+        if stop_strings(values):
+            return None  # Different content-sensitive stops are not a reusable latency context.
+        tune = dict(values.get("strata_tune") or {}) if isinstance(values.get("strata_tune"), dict) else {}
+        route = tune.get("pcie_frac")
+        if route is None:
+            route = (getattr(self.engine, "info", {}) or {}).get("pcie_frac")
+        if route is None and self.coadaptive.enabled:
+            route = self.coadaptive.base_fraction
