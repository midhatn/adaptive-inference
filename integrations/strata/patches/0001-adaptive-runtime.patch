+"""CPU-only service and HTTP ownership tests; no model or performance claim."""
+import http.client
+import json
+from pathlib import Path
+import threading
+import time
+import unittest
+from unittest import mock
+
+from serve import server
+from serve.frontend import ChatTemplate
+
+
+class TimedEngine(server.MockEngine):
+    def __init__(self, tok):
+        super().__init__(tok, "ok", max_context=65536)
+        self.proc = object()
+        self.dispatched = []
+        self.block = None
+        self.entered, self.release = threading.Event(), threading.Event()
+        self.fail = self.change_process = False
+        self.advance = lambda: None
+
+    def generate(self, ids, max_new, sampling, cancel, embeddings=None):
+        self.dispatched.append(ids[0])
+        if ids[0] == self.block:
+            self.entered.set()
+            if not self.release.wait(3):
+                raise RuntimeError("fixture owner was not released")
+        self.advance()
+        try:
+            yield from super().generate(ids, max_new, sampling, cancel, embeddings)
+        finally:
+            self.last = {"generated": 3, "prompt_ms": 1., "decode_ms": 1., "finish": "stop",
+                         "prompt_read": len(ids), "reused": 0}
+            if self.change_process:
+                self.proc = object()
+            if self.fail:
+                raise RuntimeError("fixture backend failed after DONE")
+
+
+class SchedulingService(unittest.TestCase):
+    def service(self, **config):
+        tok = server.ByteTokenizer()
+        svc = server.Service(TimedEngine(tok), tok,
+                             ChatTemplate(Path(server.ROOT) / "serve/chat_template.jinja"))
+        svc.configure_inference_scheduling({"enabled": True, **config})
+        return svc
+
+    def run_request(self, svc, number=1, *, cancel=None, sampling=None):
+        return list(svc.run([number], False, None, 8, sampling or {}, cancel or threading.Event()))
+
+    def wait_for(self, condition):
+        deadline = time.monotonic()+3
+        while not condition():
+            if time.monotonic() >= deadline:
+                self.fail("fixture transition timed out")
+            time.sleep(.005)
+
+    def test_actual_service_reorders_pending_calls_without_preempting_owner(self):
+        svc = self.service(max_cost_delay_s=0)
+        svc.engine.block = 1
+        errors = []
+        def run(number, kind):
+            cancel = threading.Event(); cancel._strata_scheduling_class = kind
+            try: self.run_request(svc, number, cancel=cancel)
+            except BaseException as exc: errors.append(exc)
+        owner = threading.Thread(target=run, args=(1, "normal"))
+        background = threading.Thread(target=run, args=(2, "background"))
+        normal = threading.Thread(target=run, args=(3, "normal"))
+        owner.start(); self.assertTrue(svc.engine.entered.wait(2))
+        try:
+            background.start(); self.wait_for(lambda: svc.inference_queue.snapshot()["pending"] == 1)
+            normal.start(); self.wait_for(lambda: svc.inference_queue.snapshot()["pending"] == 2)
+            self.assertEqual(svc.engine.dispatched, [1])
+            self.assertTrue(svc.fifo.locked())
+        finally:
+            svc.engine.release.set()
+            for thread in (owner, background, normal):
+                if thread.ident is not None: thread.join(3)
+        self.assertFalse(errors)
+        self.assertEqual(svc.engine.dispatched, [1, 3, 2])
+        self.assertFalse(svc.fifo.locked())
+        self.assertEqual(svc.inference_queue.snapshot()["pending"], 0)
+        self.assertEqual(svc.status["queued"], 0)
+
+    def test_wait_deadline_and_cancellation_keep_external_lock_owner(self):
+        for cancelled in (True, False):
+            with self.subTest(cancelled=cancelled):
+                svc = self.service(); svc.queue_timeout_s = .02
+                cancel = threading.Event()
+                if cancelled: cancel.set()
+                svc.fifo.acquire()
+                try:
+                    if cancelled:
+                        result = self.run_request(svc, cancel=cancel)
+                        self.assertEqual(result[-1][1]["finish"], "cancel")
+                    else:
+                        with self.assertRaises(server.QueueWaitExpired):
+                            self.run_request(svc, cancel=cancel)
+                    self.assertTrue(svc.fifo.locked())
+                finally: svc.fifo.release()
+                self.assertEqual(svc.engine.dispatched, [])
+                self.assertEqual(svc.inference_queue.snapshot()["pending"], 0)
+                self.assertEqual(svc.status["queued"], 0)
+
+    def test_actual_done_feedback_becomes_a_later_queue_prediction(self):
+        svc = self.service()
+        for _ in range(4): self.run_request(svc)
+        rows = list(svc.history)
+        self.assertIsNone(rows[0]["scheduling"]["predicted_execution_s"])
+        self.assertGreater(rows[3]["scheduling"]["predicted_execution_s"], 0)
+        self.assertEqual(rows[3]["scheduling"]["prediction_samples"], 3)
+        self.assertTrue(all(row["scheduling"]["trained"] for row in rows))
+        self.assertEqual(svc.request_costs.status()["observations"], 4)
+
+    def test_load_delay_is_excluded_from_the_learned_execution(self):
+        svc = self.service(); clock = [10.]
+        def admission(cancel):
+            clock[0] += 20
+            yield "ping", None
+        svc.engine.advance = lambda: clock.__setitem__(0, clock[0]+2)
+        with mock.patch.object(svc, "_preparation_admission_enabled", return_value=True), \
+                mock.patch.object(svc, "_admit_loaded", side_effect=admission), \
+                mock.patch("serve.server.time.perf_counter", side_effect=lambda: clock[0]):
+            self.run_request(svc)
+        self.assertEqual(svc.history[-1]["scheduling"]["execution_s"], 2)
+
+    def test_backend_failure_and_changed_process_do_not_train_even_with_done(self):
+        for change in (False, True):
+            with self.subTest(change=change):
+                svc = self.service()
+                svc.engine.change_process, svc.engine.fail = change, not change
+                if change: self.run_request(svc)
+                else:
+                    with self.assertRaisesRegex(RuntimeError, "fixture backend failed"):
+                        self.run_request(svc)
+                self.assertEqual(svc.request_costs.status()["observations"], 0)
+                self.assertFalse(svc.fifo.locked())
+                self.assertFalse(svc.terminal_requests)
+
+    def test_failed_execution_invalidates_an_older_cheap_estimate(self):
+        svc = self.service()
+        for _ in range(3): self.run_request(svc)
+        key = svc._request_cost_key(1,8,False,None,{},"normal")
+        self.assertIsNotNone(svc.request_costs.predict(key,now=time.monotonic())["estimate_s"])
+        svc.engine.fail = True
+        with self.assertRaisesRegex(RuntimeError,"fixture backend failed"):
+            self.run_request(svc)
+        self.assertIsNone(svc.request_costs.predict(key,now=time.monotonic())["estimate_s"])
