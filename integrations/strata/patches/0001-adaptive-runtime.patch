+        bulk.sample.return_value = SimpleNamespace(processes={101: processes[0].info}, wall_time=1000,
+                                                    monotonic_time=10)
+        self.assertFalse(sampler.sample(1000)["complete"])
+        processes[0] = process(101, cpu=2, rss=9 * GIB)
