+                       vram_headroom_mib=row["vram_headroom_mib"],
+                       execution_ram_floor_gib=row["execution_ram_floor_gib"],
+                       execution_vram_floor_mib=row["execution_vram_floor_mib"],
+                       execution_hold=row["execution_hold"],
