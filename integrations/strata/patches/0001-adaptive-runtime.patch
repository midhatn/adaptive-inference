+            if row["fraction"] == .15:
+                row["decode_ms_per_token"] = 10
+        snapshot.update(ram_commit_required=True, ram_commit_available=None)
+        native["budget_free_mib"] = 0
+        self.assertEqual(c.choose_route(snapshot, native, 128, 128, 11), .37)
+
