+
+    def test_windows_bulk_uses_fresh_monotonic_interval_without_per_pid_queries(self):
+        processes = [process(101, cpu=0, rss=9 * GIB)]
+        sampler, ps = self.sampler(processes)
+        bulk = mock.Mock()
