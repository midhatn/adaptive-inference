+        excluded = set(exclude_pids) | {os.getpid()}
+        names = {}
+        for pid, info in processes.items():
+            name = info.get("name")
+            name = name.lower().removesuffix(".exe") if isinstance(name, str) else None
+            names[pid] = name
+            if name == "strata":
+                excluded.add(pid)
+        # Resolve descendants without depending on process enumeration order.
+        children = {}
