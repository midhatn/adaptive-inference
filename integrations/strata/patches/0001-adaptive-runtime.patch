+"""Real HTTP/Service feedback through parking's effective native sampling path.
+
+The backend and hardware footprint are CPU fixtures. HTTP preparation, request
+parking seed selection, cost-key prediction/observation and owner cleanup use
+the production implementations. No parking/replay or model-quality claim.
+"""
+import copy
+import http.client
+import json
+import math
+from pathlib import Path
+import tempfile
+import threading
+import time
+import unittest
+from unittest import mock
+
+from serve import server
+from serve.frontend import ChatTemplate
+from serve.request_parking import RequestParking
+
+
+class ParkingEngine(server.MockEngine):
+    def __init__(self,tok):
+        super().__init__(tok,'ok',max_context=65536)
+        self.proc=object(); self.native_sampling=[]
+
+    def generate(self,ids,max_new,sampling,cancel,embeddings=None,park=None):
+        self.native_sampling.append(copy.deepcopy(sampling))
+        assert park is not None and park.proc is self.proc
+        try: yield from super().generate(ids,max_new,sampling,cancel,embeddings)
+        finally:
+            self.last={'generated':3,'prompt_ms':1.,'decode_ms':1.,'finish':'stop',
+                       'prompt_read':len(ids),'reused':0}
+
+
+class ParkingFeedback(unittest.TestCase):
+    def service(self):
+        tok=server.ByteTokenizer()
+        svc=server.Service(ParkingEngine(tok),tok,
+                           ChatTemplate(Path(server.ROOT)/'serve/chat_template.jinja'))
+        svc.configure_inference_scheduling({'enabled':True,'max_pending':4})
+        svc.idle_parking=server.IdleParking({'enabled':True})
+        svc.request_parking=RequestParking({'enabled':True,'directory':str(Path(tempfile.gettempdir()).resolve())})
+        return svc
+
+    def test_http_equivalent_requests_share_feedback_across_effective_seeds(self):
+        for seed_mode in ('absent','zero','explicit'):
+            with self.subTest(seed_mode=seed_mode):
+                svc=self.service(); request_seeds=[]
+                # Only hardware identity/footprint are fixtures. The actual
+                # effective_sampling method must generate/preserve native seeds.
+                with mock.patch.object(svc,'_parking_identity',return_value={'cpu_fixture':True}), \
+                     mock.patch.object(svc,'_parking_footprint',return_value={}), \
+                     mock.patch.object(svc,'start_telemetry'), \
+                     mock.patch('serve.request_parking.secrets.randbelow',side_effect=range(100,108)):
+                    httpd=server.serve(svc,port=0)
+                    try:
+                        for kind in ('normal','background'):
+                            for repetition in range(4):
+                                body={'messages':[{'role':'user','content':'Calculate 19 times 23.'}],
+                                      'stream':False,'max_tokens':10923,'reasoning_effort':'high',
+                                      'reasoning_budget_tokens':8192,'experimental_speed_projection':False,
+                                      'strata_tune':{'pcie_frac':.37},'strata_scheduling':{'class':kind}}
+                                if seed_mode=='zero': body['seed']=0
+                                elif seed_mode=='explicit': body['seed']=1000+len(request_seeds)
+                                request_seeds.append(body.get('seed'))
+                                original=copy.deepcopy(body)
+                                conn=http.client.HTTPConnection('127.0.0.1',httpd.server_address[1],timeout=3)
+                                try:
+                                    conn.request('POST','/v1/chat/completions',json.dumps(body),{'Content-Type':'application/json'})
+                                    response=conn.getresponse(); reply=json.loads(response.read())
+                                    self.assertEqual(response.status,200,reply)
+                                    self.assertEqual(reply['choices'][0]['finish_reason'],'stop')
+                                finally: conn.close()
+                                self.assertEqual(body,original)
+                                until=time.monotonic()+2
+                                while svc.admission_reserved and time.monotonic()<until: time.sleep(.005)
+                                row=svc.history[-1]['scheduling']
+                                self.assertEqual(row['prediction_samples'],repetition)
+                                self.assertTrue(row['trained'])
+                                if repetition==3:
+                                    self.assertEqual(row['prediction_reason'],'measured')
+                                    self.assertTrue(math.isfinite(row['predicted_execution_s']))
+                                    self.assertGreater(row['predicted_execution_s'],0)
+                        self.assertEqual(svc.request_costs.status()['groups'],2)
+                        self.assertEqual(svc.request_costs.status()['observations'],8)
+                        actual=[row['seed'] for row in svc.engine.native_sampling]
+                        expected=request_seeds if seed_mode=='explicit' else list(range(101,109))
+                        self.assertEqual(actual,expected,'native seeds must remain unchanged by latency grouping')
+                        self.assertEqual(svc.admission_reserved,0)
+                        self.assertFalse(svc.fifo.locked())
+                        self.assertEqual(svc.inference_queue.snapshot()['pending'],0)
+                    finally: httpd.shutdown(); httpd.server_close()
+
+    def test_seed_pooling_changes_only_latency_identity(self):
+        svc=self.service()
+        original={'seed':123,'temperature':1.,'top_p':.95,'top_k':20,
+                  'reasoning_effort':'high','reasoning_budget_tokens':8192,
+                  'experimental_speed_projection':False,'strata_tune':{'pcie_frac':.37}}
+        before=copy.deepcopy(original)
+        key=lambda sampling:svc._request_cost_key(67,10923,True,8192,sampling,'normal')
+        identity=key(original)
+        for seed in (None,0,456):
+            sample=copy.deepcopy(original)
+            if seed is None: sample.pop('seed')
+            else: sample['seed']=seed
+            self.assertEqual(key(sample),identity)
+        self.assertEqual(original,before)
+        self.assertIn('seed=123',server.StrataEngine.sampling_keys(original))
+        self.assertIn('seed=456',server.StrataEngine.sampling_keys({**original,'seed':456}))
+        for change in ({'temperature':.8},{'top_p':.5},{'top_k':10},
+                       {'strata_tune':{'pcie_frac':.65}},{'reasoning_budget_tokens':1024},
+                       {'reasoning_effort':'low'},{'experimental_speed_projection':True}):
+            self.assertNotEqual(key({**original,**change}),identity)
+
+
+if __name__=='__main__': unittest.main()
