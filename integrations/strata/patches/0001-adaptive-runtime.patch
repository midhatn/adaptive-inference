+        release = threading.Event()
+        writes = []
+
+        class Pipe:
+            def write(self, line):
+                writes.append(line)
+                if line.startswith("GEN "):
+                    entered.set()
+                    self.assert_release = release.wait(2)
+            def flush(self):
+                writes.append("flush")
