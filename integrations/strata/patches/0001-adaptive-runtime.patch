+def _reject_link(path):
+    entry = path.lstat()
+    if stat.S_ISLNK(entry.st_mode) or getattr(entry, "st_file_attributes", 0) & 0x400:
+        raise ParkingError("parking paths cannot be symlinks or reparse points")
+    return entry
