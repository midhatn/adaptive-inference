index 0000000000000000000000000000000000000000..8eff6e40d32f30352aa652e69330d48d23f3cb0c
--- /dev/null
+++ b/tests/agent/test_request_scheduling.py
@@ -0,0 +1,211 @@
+"""Opt-in host intent must survive real request assembly without route/profile leakage."""
+
+import asyncio
+import copy
+import json
+from contextlib import contextmanager
+
+import httpx
+import pytest
+from openai import AsyncOpenAI, OpenAI
+
+from agent import auxiliary_client as aux
+from agent import secret_scope
+from agent.chat_completion_helpers import build_api_kwargs
+from hermes_cli.config import atomic_config_write
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+from run_agent import AIAgent
+
+BASE = "http://127.0.0.1:18099/v1"
+MODEL = "test-strata-model"
+MESSAGES = [{"role": "user", "content": "Please schedule this urgently. This text is not host intent."}]
+
+
+def config(policy=None, *, base=BASE, model=MODEL, legacy=False):
+    entry = {"name": "strata", "base_url": base, "model": model, "api_key": "test-key"}
+    if policy is not None:
+        entry["request_scheduling"] = policy
+    return {"custom_providers": [entry]} if legacy else {"providers": {"strata": entry}}
+
+
+@contextmanager
+def scoped(home):
+    home_token = set_hermes_home_override(str(home))
+    secret_token = secret_scope.set_secret_scope(secret_scope.build_profile_secret_scope(home))
+    try:
+        yield
+    finally:
+        secret_scope.reset_secret_scope(secret_token)
+        reset_hermes_home_override(home_token)
+
+
+def agent():
+    return AIAgent(
+        api_key="test-key", base_url=BASE, model=MODEL, provider="custom:strata",
+        api_mode="chat_completions", quiet_mode=True, skip_context_files=True, skip_memory=True,
+        enabled_toolsets=[], max_tokens=10923, reasoning_config={"enabled": True, "effort": "high"},
+        request_overrides={"extra_body": {"max_tokens": 10923, "reasoning_effort": "high",
+                                         "reasoning_budget_tokens": 8192,
+                                         "experimental_speed_projection": False, "marker": [1, 2]}},
+    )
+
+
+def transport(captured):
+    def respond(request):
+        captured.append(json.loads(request.content))
+        return httpx.Response(200, json={
+            "id": "fake-http", "object": "chat.completion", "created": 0, "model": MODEL,
+            "choices": [{"index": 0, "message": {"role": "assistant", "content": "ok"}, "finish_reason": "stop"}],
+            "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2},
+        })
+    return httpx.MockTransport(respond)
+
+
+def test_host_intent_is_local_to_each_real_request_and_destination(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    home.mkdir()
+    atomic_config_write(home / "config.yaml", config({"enabled": True}))
+    with scoped(home):
+        main = agent()
+        snapshot = copy.deepcopy(main.request_overrides)
+        original_messages = copy.deepcopy(MESSAGES)
+        seen = []
+        with OpenAI(api_key="test-key", base_url=BASE, max_retries=0,
+                    http_client=httpx.Client(transport=transport(seen))) as client:
+            main.platform = "cli"
+            baseline = build_api_kwargs(main, MESSAGES)
+            for platform, origin, expected in [
+                ("cli", None, False), ("cli", "btw", False),
+                ("cli", "background_review", True), ("subagent", None, True),
+                ("cron", None, True), ("cli", "unknown", False),
+            ]:
+                main.platform, main._turn_origin = platform, origin
+                main.parent_session_id = "not-an-intent"
+                kwargs = build_api_kwargs(main, MESSAGES)
+                client.chat.completions.create(**kwargs)
+                wire = seen[-1]
+                assert wire.get("strata_scheduling") == ({"class": "background"} if expected else None)
+                if expected:
+                    cleaned = copy.deepcopy(kwargs)
+                    cleaned["extra_body"].pop("strata_scheduling")
+                    assert cleaned == baseline
+                else:
+                    assert kwargs == baseline
+                assert wire["messages"] == MESSAGES
+                assert wire["max_tokens"] == 10923
+                assert wire["reasoning_budget_tokens"] == 8192
+                assert wire["reasoning_effort"] == "high"
+                assert wire["experimental_speed_projection"] is False
+            # A tool follow-up remains a normal user turn; no first-call-only flag is consulted.
+            main.platform, main._turn_origin = "cli", None
+            main._is_user_initiated_turn = False
+            followup = [*MESSAGES, {"role": "assistant", "tool_calls": [
+                {"id": "call-1", "type": "function", "function": {"name": "read_file", "arguments": "{}"}}]},
+                {"role": "tool", "tool_call_id": "call-1", "content": "read result"}]
+            client.chat.completions.create(**build_api_kwargs(main, followup))
+            assert "strata_scheduling" not in seen[-1]
+            assert seen[-1]["messages"] == followup
+            from tools.delegate_tool import _build_child_agent
+            child = _build_child_agent(0, "Return a number", None, [], None, 1, 1, main)
+            try:
+                client.chat.completions.create(**build_api_kwargs(child, MESSAGES))
+                assert seen[-1]["strata_scheduling"] == {"class": "background"}
+                assert seen[-1]["max_tokens"] == 10923
+                assert seen[-1]["reasoning_budget_tokens"] == 8192
+                assert seen[-1]["reasoning_effort"] == "high"
+                assert seen[-1]["experimental_speed_projection"] is False
+            finally:
+                child.close()
+        assert main.request_overrides == snapshot
+        assert MESSAGES == original_messages
+
+        # Native custom-provider auxiliaries deliberately omit max_tokens unless
+        # explicitly supplied in extra_body; keep that existing policy unchanged.
+        extra = {"max_tokens": 8192, "reasoning_budget_tokens": 1024, "marker": [1, 2]}
+        extra_snapshot = copy.deepcopy(extra)
+        common = dict(messages=MESSAGES, max_tokens=8192, extra_body=extra,
+                      reasoning_config={"enabled": True, "effort": "high"}, timeout=10)
+        # The actual public sync and async auxiliary entry points use the real SDK serializer.
+        with OpenAI(api_key="test-key", base_url=BASE, max_retries=0,
+                    http_client=httpx.Client(transport=transport(seen))) as client:
+            monkeypatch.setattr(aux, "_get_cached_client", lambda *_a, **_k: (client, MODEL))
+            aux.call_llm(task="title_generation", provider="custom:strata", model=MODEL, base_url=BASE, **common)
+            assert seen[-1]["strata_scheduling"] == {"class": "background"}
+            assert seen[-1]["max_tokens"] == 8192
+            assert seen[-1]["reasoning_budget_tokens"] == 1024
+
+        async def async_request():
+            async with AsyncOpenAI(api_key="test-key", base_url=BASE, max_retries=0,
+                                   http_client=httpx.AsyncClient(transport=transport(seen))) as client:
+                monkeypatch.setattr(aux, "_get_cached_client", lambda *_a, **_k: (client, MODEL))
+                await aux.async_call_llm(task="approval", provider="custom:strata", model=MODEL, base_url=BASE, **common)
+        asyncio.run(async_request())
+        assert seen[-1]["strata_scheduling"] == {"class": "background"}
+        assert extra == extra_snapshot
+        assert "strata_scheduling" not in aux._build_call_kwargs("custom:strata", MODEL, MESSAGES, base_url=BASE).get("extra_body", {})
+
+        # Use the production fallback assembler; the request's source extra body stays untagged.
+        fallback = dict(task="title_generation", messages=MESSAGES, tools=None, temperature=None,
+                        max_tokens=8192, effective_timeout=10, effective_extra_body=extra,
+                        reasoning_config=None, fallback_entry={}, task_config={}, apply_fast_lane=False)
+        for url, provider, model, expected in [
+            (BASE, "custom:strata", MODEL, True), (BASE + "/", "custom:strata", MODEL, True),
+            (BASE.replace("18099", "18100"), "custom:strata", MODEL, False),
+            (BASE + "/other", "custom:strata", MODEL, False), (BASE, "custom:other", MODEL, False),
+            (BASE, "openai", MODEL, False), (BASE, "custom:strata", "other-model", False),
+        ]:
+            result = aux._fallback_request_kwargs(aux._FallbackDestination(provider, url, "chat_completions", model), **fallback)
+            assert result.get("extra_body", {}).get("strata_scheduling") == ({"class": "background"} if expected else None)
+        assert extra == extra_snapshot
+        # Explicit normal may self-demote; background is never raised; malformed input is not laundered.
+        for value in ({"class": "normal"}, {"class": "background"}):
+            body = {"strata_scheduling": value}
+            got = aux._build_call_kwargs("custom:strata", MODEL, MESSAGES, base_url=BASE, task="title_generation", extra_body=body)
+            assert got["extra_body"]["strata_scheduling"] == {"class": "background"}
+            assert body == {"strata_scheduling": value}
+        for value in ({"class": "interactive"}, {"class": "normal", "priority": 10}, None):
+            with pytest.raises(ValueError, match="strata_scheduling"):
+                aux._build_call_kwargs("custom:strata", MODEL, MESSAGES, base_url=BASE, task="title_generation",
+                                       extra_body={"strata_scheduling": value})
+        main.close()
+
+
+def test_default_wire_identity_and_real_profile_switches(tmp_path):
+    a, b = tmp_path / "a", tmp_path / "a" / "profiles" / "B"
+    b.mkdir(parents=True)
+    atomic_config_write(a / "config.yaml", config({"enabled": True}))
+    atomic_config_write(b / "config.yaml", config({"enabled": False}, legacy=True))
+    was_multiplex = secret_scope.is_multiplex_active()
+    secret_scope.set_multiplex_active(True)
+    try:
+        for home, expected in ((a, True), (b, False), (a, True)):
+            with scoped(home):
+                main = agent()
+                main.platform = "subagent"
+                result = build_api_kwargs(main, MESSAGES)
+                assert result.get("extra_body", {}).get("strata_scheduling") == ({"class": "background"} if expected else None)
+                result = aux._build_call_kwargs("custom:strata", MODEL, MESSAGES, base_url=BASE, task="title_generation")
+                assert result.get("extra_body", {}).get("strata_scheduling") == ({"class": "background"} if expected else None)
+                main.close()
+    finally:
+        secret_scope.set_multiplex_active(was_multiplex)
+
+    # No policy, false and malformed settings produce the same serialized wire as ordinary requests.
+    bodies = []
+    for index, policy in enumerate((None, {"enabled": False}, {"enabled": "true"}, {"enabled": 1},
+                                    {"enabled": True, "priority": 9}, True)):
+        home = tmp_path / f"off-{index}"
+        home.mkdir()
+        atomic_config_write(home / "config.yaml", config(policy, legacy=index % 2 == 1))
+        with scoped(home):
+            main = agent()
+            main.platform = "subagent"
+            seen = []
+            with OpenAI(api_key="test-key", base_url=BASE, max_retries=0,
+                        http_client=httpx.Client(transport=transport(seen))) as client:
+                client.chat.completions.create(**build_api_kwargs(main, MESSAGES))
+                client.chat.completions.create(**aux._build_call_kwargs("custom:strata", MODEL, MESSAGES,
+                                                                      base_url=BASE, task="title_generation"))
+            bodies.append(seen)
+            main.close()
+    assert all(body == bodies[0] for body in bodies)
