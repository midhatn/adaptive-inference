index 0000000000000000000000000000000000000000..a57f75e7eb9fae4e4afb4278c4fb0f2a6b66097c
--- /dev/null
+++ b/agent/request_scheduling.py
@@ -0,0 +1,50 @@
+"""Host-declared self-demotion for an explicitly opted-in Strata route.
+
+This is pending-request intent, not authorization or resource admission. The
+request assemblers call it per destination; generated metadata never enters
+shared overrides or a fallback's source request.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def _route_enabled(provider: str, model: str, base_url: str) -> bool:
+    from agent.agent_init import _custom_provider_model_matches
+    from hermes_cli.config import load_config_readonly
+    from hermes_cli.config_providers import _entries_for_route
+
+    identity = str(provider or "").strip().lower()
+    if identity != "custom" and not identity.startswith("custom:"):
+        return False
+    key = identity.partition(":")[2]
+    matches = []
+    for entry in _entries_for_route(base_url, None, load_config_readonly()):
+        names = {str(entry.get(field) or "").strip().lower() for field in ("name", "provider_key")}
+        if key and key not in names:
+            continue
+        if _custom_provider_model_matches(model, entry):
+            matches.append(entry.get("request_scheduling") == {"enabled": True})
+    # A bare custom route shared by conflicting entries has no unambiguous opt-in.
+    return bool(matches) and all(matches)
+
+
+def merge_request_scheduling(
+    kwargs: dict[str, Any], *, provider: str, model: str, base_url: str,
+    platform: str | None = None, turn_origin: str | None = None,
+    auxiliary_task: str | None = None,
+) -> dict[str, Any]:
+    """Copy only a background request's body; normal and unbound paths are unchanged."""
+    background = (
+        platform in {"subagent", "cron"}
+        or turn_origin == "background_review"
+        or (isinstance(auxiliary_task, str) and bool(auxiliary_task.strip()))
+    )
+    if not background or not _route_enabled(provider, model, base_url):
+        return kwargs
+    body = kwargs.get("extra_body") or {}
+    current = body.get("strata_scheduling")
+    if "strata_scheduling" in body and current not in ({"class": "normal"}, {"class": "background"}):
+        raise ValueError("strata_scheduling must contain only class: normal or background")
+    return {**kwargs, "extra_body": {**body, "strata_scheduling": {"class": "background"}}}
